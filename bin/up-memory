#!/usr/bin/env bash
# up-memory [--settings-only] [dir]
#
# Keeps Claude's memory for a project in ~/dev/up-priv/memory/<project>/.
# up-priv is private: the memory never lands in the project's repo, which may
# be public.
#
# Claude is told with autoMemoryDirectory in the project's
# .claude/settings.local.json, a file git ignores: the repo doesn't change. If
# the project already had memory in the default place
# (~/.claude/projects/<path>/memory), the notes are moved first, and a note that
# already exists on the other side is never overwritten.
#
# Then it pushes up-priv to GitHub, in the background. With --settings-only it
# neither pushes nor prints notices: `up` uses it right before opening Claude,
# which runs this same script as a hook right away.
#
# It is Claude's SessionStart hook. Without a dir, it uses the current project.
set -uo pipefail
shopt -s nullglob dotglob
export GIT_TERMINAL_PROMPT=0   # never ask for a user or a password

PRIV=$HOME/dev/up-priv
NOTICE=$HOME/.cache/up/notice   # a problem from last time, to report

# move_notes <from> <to>: moves every note without overwriting any, and removes
# <from>. If some note already exists in <to>, lists them and fails.
move_notes() {
  local f
  for f in "$1"/*; do mv -n "$f" "$2/" 2>/dev/null; done
  rmdir "$1" 2>/dev/null && return 0
  echo "up-memory: did not move Claude's memory into up-priv. These notes in $1 already exist in $2 with different content, and none was overwritten:"
  for f in "$1"/*; do echo "  ${f##*/}"; done
  echo "Merge each one by hand into $2, delete $1, and open Claude again."
  return 1
}

connect() {
  local top common root url name dst mem cfg value tmp
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 0   # not a repo
  common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)
  root=$top
  case $common in */.git) root=${common%/.git} ;; esac   # in a worktree, the default memory is the main repo's

  # The repo's name on GitHub, or the folder's name if it's not on GitHub.
  url=$(git -C "$top" remote get-url origin 2>/dev/null || true)
  case $url in
    *github.com[:/]*) name=$(basename "${url%.git}") ;;
    *) name=$(basename "$root") ;;
  esac
  dst=$PRIV/memory/$name
  # shellcheck disable=SC2088 # Claude expands the ~: the same setting works on the Mac and on the live
  value="~/dev/up-priv/memory/$name"
  cfg=$top/.claude/settings.local.json
  mkdir -p "$dst"

  # Move the memory from the default place, and from up-priv/memoria/ (older versions).
  mem=$HOME/.claude/projects/$(printf %s "$root" | sed 's/[^a-zA-Z0-9]/-/g')/memory
  if [ -L "$mem" ]; then
    rm "$mem"   # a link from an older version: the notes are already in up-priv
  elif [ -d "$mem" ]; then
    move_notes "$mem" "$dst" || return 0
  fi
  if [ -d "$PRIV/memoria/$name" ]; then
    move_notes "$PRIV/memoria/$name" "$dst" || return 0
    rmdir "$PRIV/memoria" 2>/dev/null
  fi

  [ "$(jq -r '.autoMemoryDirectory // empty' "$cfg" 2>/dev/null)" = "$value" ] && return 0

  # First make git ignore the file, without touching the project's .gitignore:
  # the repo may be public, and the file has the permissions you approved.
  if git -C "$top" ls-files --error-unmatch .claude/settings.local.json >/dev/null 2>&1; then
    if ! git -C "$top" update-index --skip-worktree .claude/settings.local.json 2>/dev/null; then
      echo "up-memory: could not make git ignore $cfg (is another git running?), so Claude was not told to use $dst yet. It will try again next time."
      return 0
    fi
  elif ! git -C "$top" check-ignore -q .claude/settings.local.json; then
    mkdir -p "$common/info"
    echo "/.claude/settings.local.json" >>"$common/info/exclude"
  fi

  # Then tell Claude where the memory is.
  mkdir -p "$top/.claude"
  [ -s "$cfg" ] || echo '{}' >"$cfg"
  tmp=$(mktemp)   # outside the repo
  if jq --arg v "$value" '.autoMemoryDirectory = $v' "$cfg" >"$tmp"; then
    cat "$tmp" >"$cfg"
  else
    echo "up-memory: $cfg is not valid JSON; could not tell Claude to use $dst."
  fi
  rm -f "$tmp"
}

# Push up-priv. One push at a time, and nothing if someone is resolving a
# conflict there.
push() {
  local g   # lock is not local: the trap uses it after the function returns
  cd "$PRIV" || return
  g=$(git rev-parse --absolute-git-dir) || return
  [ -d "$g/rebase-merge" ] || [ -d "$g/rebase-apply" ] || [ -f "$g/MERGE_HEAD" ] && return
  lock=$g/up-memory.lock
  find "$lock" -maxdepth 0 -mmin +10 -exec rmdir {} \; 2>/dev/null   # left by a push that died
  mkdir "$lock" 2>/dev/null || return
  trap 'rmdir "$lock"' EXIT
  git add -A
  git diff --cached --quiet || git commit -qm "up-memory: $(hostname -s)"
  if ! git pull -q --rebase --autostash; then
    if [ -d "$g/rebase-merge" ] || [ -d "$g/rebase-apply" ]; then   # it's this pull's
      git rebase --abort
      mkdir -p "${NOTICE%/*}"
      echo "up-memory: Claude's memory changed on two machines at once and could not be merged automatically. Tell the user: it has to be resolved in $PRIV (git pull --rebase)." >"$NOTICE"
    fi
    return
  fi
  git push -q
}

only=
[ "${1:-}" = --settings-only ] && { only=1; shift; }

[ -d "$PRIV/.git" ] || exit 0
# Whatever this script prints, Claude reads at startup.
if [ -z "$only" ] && [ -s "$NOTICE" ]; then cat "$NOTICE"; rm -f "$NOTICE"; fi
connect "${1:-${CLAUDE_PROJECT_DIR:-$PWD}}"
[ -n "$only" ] && exit 0

# In the background and silent, so Claude doesn't wait.
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}"
(push) </dev/null >/dev/null 2>&1 &
