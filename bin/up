#!/usr/bin/env bash
# up [project | owner/project | GitHub URL]
#
# Opens Claude on a GitHub project, inside tmux: if the terminal closes, it
# keeps running (`up <project>` again, or `tmux attach`). If the project is not
# in ~/dev, it clones it. If the repo keeps its Claude memory in a memoria/
# folder, it's copied to where Claude looks for it (`down` copies it back).
#
#   up                                 lists your repos to pick one
#   up project                         one of yours
#   up openai/codex                    any GitHub repo
#   up https://github.com/openai/codex the same
#
# On someone else's repo, Claude asks before doing anything: the repo could
# carry hidden instructions, and this machine has access to all your repos.
set -euo pipefail

mkdir -p "$HOME/dev"

repo=${1:-}
if [ -z "$repo" ]; then
  repos=()
  while IFS= read -r r; do repos+=("$r"); done < <(gh repo list --limit 20 --json nameWithOwner,pushedAt \
    --jq 'sort_by(.pushedAt) | reverse | .[].nameWithOwner')
  for i in "${!repos[@]}"; do printf '%3d  %s\n' $((i + 1)) "${repos[i]#*/}"; done
  read -rp "Number, name, or owner/name of any repo: " repo
  if [[ $repo =~ ^[0-9]+$ ]] && [ "$repo" -ge 1 ] && [ "$repo" -le ${#repos[@]} ]; then
    repo=${repos[repo - 1]}
  fi
fi

# Also accept the URL, with or without https:// and .git.
repo=${repo#https://}
repo=${repo#http://}
repo=${repo#github.com/}
repo=${repo%/}
repo=${repo%.git}
if ! [[ $repo =~ ^([A-Za-z0-9-]+/)?[A-Za-z0-9._-]+$ ]] || [[ $repo == *..* ]]; then
  echo "up: '$repo' is not a GitHub repo (project or owner/project)" >&2
  exit 1
fi
me=$(gh api user --jq .login)
[[ $repo == */* ]] || repo=$me/$repo

name=${repo#*/}
dir=$HOME/dev/$name
[ -d "$dir/.git" ] || gh repo clone "$repo" "$dir"
# The repo's Claude memory, if it keeps one in memoria/. Notes already there
# from earlier in this session are not overwritten.
mem=$HOME/.claude/projects/$(printf %s "$dir" | sed 's/[^a-zA-Z0-9]/-/g')/memory
if [ -d "$dir/memoria" ]; then
  mkdir -p "$mem"
  rsync -a --ignore-existing "$dir/memoria/" "$mem/"
fi

claude=claude
if [ "${repo%%/*}" = "$me" ]; then
  # Your repo: Claude doesn't ask whether you trust the folder.
  f=$HOME/.claude.json
  [ -s "$f" ] || echo '{}' >"$f"
  tmp=$(mktemp)
  jq --arg d "$dir" '.projects[$d].hasTrustDialogAccepted = true' "$f" >"$tmp" && cat "$tmp" >"$f"
  rm -f "$tmp"
else
  claude="claude --permission-mode default"
fi

# What runs in tmux sets up its own environment (PATH and Claude key): it works
# even when `up` is called from a terminal that doesn't have them.
run="export PATH=\"\$HOME/.local/bin:\$HOME/.cargo/bin:\$HOME/.bun/bin:\$PATH\"; [ -f ~/.config/up/claude.env ] && { set -a; . ~/.config/up/claude.env; set +a; }; $claude; exec bash"

session=${name//[.:]/_}
if [ -n "${TMUX:-}" ]; then
  tmux has-session -t "=$session" 2>/dev/null || tmux new-session -d -s "$session" -c "$dir" "$run"
  exec tmux switch-client -t "=$session"
fi
exec tmux new-session -A -s "$session" -c "$dir" "$run"
