#!/usr/bin/env bash
# down — before powering off.
#
# Pushes the changes of every repo in ~/dev, with their worktrees. A repo that
# keeps its Claude memory in a memoria/ folder gets the memory copied back there
# first, so it's pushed too. If everything got pushed, logs out of Tailscale and
# powers off. If something couldn't be pushed, says what and doesn't power off.
#
# - In private repos it commits everything that changed. In public ones it
#   doesn't commit for you: it pushes your commits and lists what's uncommitted.
# - It never pushes files over 50 MB (a video downloaded by mistake) nor
#   .claude/settings.local.json (the memory setting).
# - It doesn't power off if there are unpushed commits on another branch, a
#   stash, a half-done merge, or folders without git in ~/dev.
# - Claude memory of a repo without memoria/ is not kept: it warns, that's all.
set -uo pipefail
shopt -s nullglob
export GIT_TERMINAL_PROMPT=0   # never ask for a user or a password

BIG=50   # MB
SKIP=(':(exclude).claude/settings.local.json*' ':(exclude).claude/worktrees')

# commit_all: adds everything that changed, except big files and what's never pushed.
commit_all() {
  local list f
  list=$(mktemp)
  while IFS= read -r -d '' f; do
    case $f in .claude/settings.local.json* | .claude/worktrees/*) continue ;; esac
    if [ -d "$f" ]; then
      echo "  not pushing $f: it's another git repo"
    elif [ -f "$f" ] && [ "$(du -m "$f" | cut -f1)" -gt "$BIG" ]; then
      echo "  not pushing $f: it's over $BIG MB"
    else
      printf '%s\0' "$f" >>"$list"
    fi
  done < <(git ls-files -z -m -o -d --exclude-standard)
  if [ -s "$list" ] && ! git add -A --pathspec-from-file="$list" --pathspec-file-nul; then
    rm -f "$list"
    return 1
  fi
  rm -f "$list"
  git diff --cached --quiet || git commit -qm "down: $(hostname -s) $(date '+%F %R')"
}

# memory_dir <repo dir>: where Claude keeps that repo's memory.
memory_dir() { printf '%s/.claude/projects/%s/memory' "$HOME" "$(printf %s "$1" | sed 's/[^a-zA-Z0-9]/-/g')"; }

# push_dir <dir>: gets that working copy onto GitHub. Fails if anything is left.
push_dir() (
  cd "$1" || exit 1
  g=$(git rev-parse --git-dir) || exit 1
  if [ -d "$g/rebase-merge" ] || [ -d "$g/rebase-apply" ] || [ -f "$g/MERGE_HEAD" ]; then
    echo "  a merge or a rebase is half done"
    exit 1
  fi
  git symbolic-ref -q HEAD >/dev/null || { echo "  not on a branch"; exit 1; }

  private=
  [ "$(gh repo view --json visibility -q .visibility 2>/dev/null)" = PRIVATE ] && private=1
  if [ -n "$private" ]; then commit_all || exit 1; fi

  if git rev-parse -q --verify '@{u}' >/dev/null; then
    if [ "$(git rev-list --count '@{u}..HEAD')" -gt 0 ]; then
      if ! git pull -q --rebase --autostash; then
        git rebase --abort 2>/dev/null
        echo "  it also changed on GitHub and could not be merged automatically"
        exit 1
      fi
      git push -q || exit 1
    fi
  elif git rev-parse -q --verify HEAD >/dev/null; then
    git push -q -u origin HEAD || exit 1   # new branch
  fi

  left=0
  dirty=$(git status --porcelain -- . "${SKIP[@]}")
  if [ -n "$dirty" ]; then
    [ -n "$private" ] || echo "  it's public (or I can't tell it's private): I don't commit for you. Uncommitted:"
    [ -n "$private" ] && echo "  not pushed:"
    printf '%s\n' "$dirty" | sed 's/^/    /'
    left=1
  fi
  for b in $(git for-each-ref --format='%(refname:short)' refs/heads); do
    if [ -n "$(git log --oneline -1 "$b" --not --remotes)" ]; then
      echo "  branch $b has unpushed commits"
      left=1
    fi
  done
  if [ -n "$(git stash list)" ]; then
    echo "  there are changes saved with git stash"
    left=1
  fi
  exit "$left"
)

cd "$HOME/dev" || exit 1
failed=()
kept=()
for d in */; do
  d=${d%/}
  if [ ! -e "$d/.git" ]; then
    echo "✗ $d: not a git repo, and what's in it is lost at shutdown"
    failed+=("$d")
    continue
  fi
  # The repo's Claude memory back into its memoria/ folder (only if there is some).
  mem=$(memory_dir "$HOME/dev/$d")
  if [ -d "$HOME/dev/$d/memoria" ] && [ -d "$mem" ] && [ -n "$(ls -A "$mem")" ]; then
    rsync -a --delete "$mem/" "$HOME/dev/$d/memoria/"
    kept+=("$mem")
  fi
  git -C "$d" worktree prune
  copies=()
  while IFS= read -r w; do copies+=("$w"); done < <(git -C "$d" worktree list --porcelain | sed -n 's/^worktree //p')
  # Worktrees first, so their branches are already pushed when the main copy is checked.
  for ((i = ${#copies[@]} - 1; i >= 0; i--)); do
    label=$d
    [ "$i" -gt 0 ] && label="$d (${copies[i]##*/})"
    if out=$(push_dir "${copies[i]}" 2>&1); then
      echo "✓ $label"
    else
      echo "✗ $label"
      [ -n "$out" ] && echo "$out"
      failed+=("$label")
    fi
  done
done

for m in "$HOME"/.claude/projects/*/memory; do
  [ -d "$m" ] && [ -n "$(ls -A "$m")" ] || continue
  case " ${kept[*]-} " in *" $m "*) continue ;; esac
  echo "! Claude memory not kept (its repo has no memoria/ folder), lost at shutdown: $m"
done

if [ ${#failed[@]} -gt 0 ]; then
  echo
  echo "Not powering off: still to push: ${failed[*]}."
  exit 1
fi

command -v systemctl >/dev/null || { echo "Everything pushed."; exit 0; }
echo
echo "Everything pushed. Powering off in 10 seconds (Ctrl-C to cancel)."
sleep 10
command -v tailscale >/dev/null && sudo tailscale logout 2>/dev/null
sudo systemctl poweroff
