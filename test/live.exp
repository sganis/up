# expect: does what you'd do in the live system's terminal. Used by test/mint-inside.sh.
# Needs REPO in the environment.
#  1. runs setup.sh as with curl | sh;
#  2. in the same terminal types `up REPO` and waits for Claude to open;
#  3. leaves tmux (Claude keeps running) and tries the commands in that same terminal.
set timeout 2400
spawn bash --norc --noprofile
stty rows 40 columns 120 < $spawn_out(slave,name)
send "cat /src/setup.sh | sh; echo END-\$((1+1))\r"
expect {
  "END-2" {}
  timeout { puts "\n### timeout: setup.sh didn't finish"; exit 1 }
}
set timeout 240
send "up $env(REPO)\r"
expect {
  "trust this folder" { puts "\n### Claude asked whether it trusts the folder"; exit 2 }
  "for shortcuts" { puts "\n### Claude is open" }
  "open terminal failed" { puts "\n### tmux didn't start"; exit 1 }
  timeout { puts "\n### timeout waiting for Claude"; exit 1 }
}
sleep 2
# Ctrl-b d: leave tmux without closing Claude.
send "\002d"
sleep 2
send "for c in up down vpn drive claude cargo rustc bun oc kubectl vim; do command -v \$c >/dev/null && echo HAS-\$c || echo MISSING-\$c; done; echo END-\$((2+2))\r"
expect {
  "END-4" {}
  timeout { puts "\n### timeout trying the commands"; exit 1 }
}
send "exit\r"
expect eof
exit 0
